// ============================================================
// E-CLASSE RDC — Schéma de base de données
// ============================================================
// En développement : SQLite (fichier local, zéro configuration)
// En production : remplacer provider par "postgresql" et
// définir DATABASE_URL vers ta base Postgres (ex: Neon, Supabase, Railway)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- UTILISATEURS ----------------

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String?
  image          String?
  role           Role      @default(STUDENT)
  createdAt      DateTime  @default(now())

  subscriptions  Subscription[]
  enrollments    Enrollment[]
  certificates   Certificate[]
  payments       Payment[]
  sentMessages   Message[]
  coursesTaught  Course[] @relation("CourseInstructor")
  conversationsAsStudent Conversation[] @relation("StudentConversations")
  conversationsAsTeacher Conversation[] @relation("TeacherConversations")
}

enum Role {
  STUDENT
  FORMATEUR
  ADMIN
}

// ---------------- ABONNEMENTS ----------------

model Plan {
  id            String   @id @default(cuid())
  name          String   // "Gratuit", "PRO", "Expert"
  priceUSD      Int      // prix en cents (ex: 999 = 9.99$)
  durationDays  Int      // durée de l'abonnement
  description   String?
  subscriptions Subscription[]
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id])
  startDate  DateTime @default(now())
  endDate    DateTime
  status     SubStatus @default(ACTIVE)
  createdAt  DateTime @default(now())
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ---------------- FORMATIONS ----------------

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String?  // nom d'icône ou emoji
  courses   Course[]
  teacherApplications TeacherApplication[]
}

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String
  coverImage    String?
  level         Level    @default(DEBUTANT)
  type          CourseType @default(GRATUITE)
  priceUSD      Int      @default(0) // 0 si gratuite
  certifying    Boolean  @default(false)
  instructor    String?  // nom affiché (libre, si pas de compte formateur lié)
  instructorId  String?  // lié à un compte utilisateur de rôle FORMATEUR
  instructorUser User?   @relation("CourseInstructor", fields: [instructorId], references: [id])
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  createdAt     DateTime @default(now())

  lessons       Lesson[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  conversations Conversation[]
  resources     CourseResource[]
  exercises     Exercise[]
}

enum Level {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum CourseType {
  GRATUITE
  ABORDABLE
  CERTIFIANTE
  EXPERTE
}

model Lesson {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  title     String
  order     Int
  videoUrl  String?
  content   String?

  completions LessonCompletion[]
}

// Documents (PDF/Word) attachés à une formation : supports de cours,
// notes, fiches complémentaires. Stockés directement en base comme les CV
// de candidature formateur, pour éviter un service de stockage tiers.
model CourseResource {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  fileName  String
  mimeType  String
  fileSize  Int
  fileData  Bytes
  createdAt DateTime @default(now())
}

// Questionnaire/exercice rédigé directement par l'admin (pas un fichier) :
// un titre, des instructions optionnelles, et une liste de questions.
model Exercise {
  id           String             @id @default(cuid())
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id])
  title        String
  instructions String?
  createdAt    DateTime           @default(now())
  questions    ExerciseQuestion[]
}

model ExerciseQuestion {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  order         Int
  question      String
  choices       String[] // vide si question ouverte (sans choix multiples)
  correctChoice Int?     // index dans "choices" ; null si question ouverte
}

// ---------------- PROGRESSION / INSCRIPTIONS ----------------

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  progress    Int      @default(0) // pourcentage 0-100
  completed   Boolean  @default(false)
  enrolledAt  DateTime @default(now())

  lessonCompletions LessonCompletion[]

  @@unique([userId, courseId])
}

// Trace quelle leçon a été terminée, pour calculer la progression réelle
// et déclencher automatiquement la génération du certificat.
model LessonCompletion {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
}

// ---------------- CERTIFICATS ----------------

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  partnerLabel  String?  // ex: "Kinshasa Bible College"
  qrCode        String?  // data URL du QR code généré
  issuedAt      DateTime @default(now())
  verifyCode    String   @unique @default(cuid())
}

// ---------------- PAIEMENTS ----------------

model Payment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amountUSD     Int
  provider      PaymentProvider
  channel       String?  // ex: "OM" (Orange Money), "MOMO", "VISA" — renvoyé par CinetPay
  providerRef   String?  // référence transaction CinetPay/Stripe
  status        PaymentStatus @default(PENDING)
  purpose       String   // "subscription:<planId>" ou "course:<courseId>"
  createdAt     DateTime @default(now())
}

enum PaymentProvider {
  CINETPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// ---------------- MESSAGERIE (formateurs <-> étudiants) ----------------

// Un fil de discussion entre un étudiant et un formateur, dans le contexte
// d'une formation précise (un même duo peut avoir un fil par formation).
model Conversation {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentConversations", fields: [studentId], references: [id])
  teacherId String
  teacher   User     @relation("TeacherConversations", fields: [teacherId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]

  @@unique([studentId, teacherId, courseId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ---------------- CANDIDATURES FORMATEUR ----------------

// Formulaire public "devenir formateur" : accessible sans compte, examiné
// par l'admin dans /admin/teacher-applications. Le CV est stocké directement
// en base (petit volume attendu, évite de dépendre d'un service de stockage
// de fichiers tiers).
model TeacherApplication {
  id           String            @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  categoryId   String?           // null si le candidat a choisi "Autre"
  category     Category?         @relation(fields: [categoryId], references: [id])
  customDomain String?           // domaine saisi librement quand categoryId est null
  experience   String            // résumé de l'expérience / des qualifications
  motivation   String
  portfolioUrl String?           // lien optionnel (LinkedIn, portfolio, chaîne YouTube...)
  cvFileName   String
  cvMimeType   String
  cvData       Bytes
  status       ApplicationStatus @default(PENDING)
  adminNote    String?           // motif interne en cas de refus
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ---------------- FORMULAIRE DE CONTACT ----------------

// Message public envoyé depuis /contact (aucun compte requis), consulté et
// traité par l'admin dans /admin/contact-messages.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
